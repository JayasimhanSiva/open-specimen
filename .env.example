# Copy to .env for local development. Never commit the real .env.

# 1 locally, 0 (or unset) in production
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG is 0. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Comma-separated, only needed outside Render (Render adds its hostname automatically)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# SQL database. Unset = local SQLite file. Production: a PostgreSQL URL.
DATABASE_URL=

# MongoDB for chat logs and feedback, e.g. a free MongoDB Atlas cluster:
#   mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=open_specimen

# Optional: a GitHub token only raises the GitHub API rate limit (60 -> 5000 requests/hour)
GITHUB_TOKEN=

# Optional: where the AI model is cached (~70 MB)
MATCHER_CACHE_DIR=

# Admin account created on deploy (Render runs `createsuperuser --noinput` with these). Locally, run
#   python manage.py createsuperuser
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
